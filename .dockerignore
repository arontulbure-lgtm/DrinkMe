# Allowlist: nothing enters the build context unless named here, so secrets
# (.env, server/.env, serviceAccount.json), server/data and the client stay out.
# A new server source file must be added here and in the Dockerfile.
*
!server/
server/*
!server/package.json
!server/package-lock.json
!server/server.js
!server/ai/
!server/app-check.js
!server/storage/
# Only the scripts the server needs in production (backups, Postgres migration and export). Owner and
# developer tools (testapi, testusers, firebase-configure, official, env-remove, test-postgres,
# docker-smoke) stay out of the image.
!server/scripts/backup.js
!server/scripts/postgres-cli.mjs
!server/scripts/migrate-to-postgres.mjs
!server/scripts/export-from-postgres.mjs
